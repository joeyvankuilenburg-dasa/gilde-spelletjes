# AI-gesprek
# -----------
# API-sleutels zijn alleen beschikbaar in de Netlify Function. Gebruik voor
# deze waarden NOOIT het Vite-voorvoegsel VITE_, want dat maakt ze openbaar in
# de browserbundle.
#
# Zonder configuratie blijft de ingebouwde, regelgestuurde gesprekspartner
# werken. Zet AI_PROVIDER op "gemini" of "openai-compatible" om een API te
# activeren.
AI_PROVIDER=rules

# Google Gemini via de officiële OpenAI-compatibele API.
# AI_PROVIDER=gemini
# AI_API_KEY=replace-with-a-server-side-secret
# AI_MODEL=gemini-3.6-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Een andere OpenAI-compatibele aanbieder.
# AI_PROVIDER=openai-compatible
# AI_API_KEY=replace-with-a-server-side-secret
# AI_MODEL=provider-model-name
# AI_BASE_URL=https://provider.example/v1

# Alleen aanpassen wanneer de aanbieder een andere authenticatieheader gebruikt.
# Voor Authorization: Bearer <key> zijn de standaardwaarden al goed.
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer

# Veilige grenzen voor kosten, wachttijd en antwoordlengte.
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=220
AI_TEMPERATURE=0.7
